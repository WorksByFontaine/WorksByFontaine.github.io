<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Listed — Property Listing Generator</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Newsreader:ital,wght@0,500;0,600;0,700;1,500&family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
<style>
  :root {
    --bg: #F5F6F8;
    --panel: #FFFFFF;
    --panel-2: #ECEDF1;
    --border: #E0E2E8;
    --ink: #14171C;
    --muted: #6B7280;
    --wine: #7A2E3A;
    --wine-soft: #F5E7E9;
    --gold: #B8912F;
    --gold-soft: #F7EFDA;
    --display: 'Newsreader', serif;
    --body: 'Inter', sans-serif;
    --ease: cubic-bezier(0.22, 1, 0.36, 1);
  }

  * { box-sizing: border-box; margin: 0; padding: 0; }

  body {
    background: var(--bg);
    color: var(--ink);
    font-family: var(--body);
    line-height: 1.6;
    -webkit-font-smoothing: antialiased;
  }

  a { color: inherit; text-decoration: none; }

  .back-link {
    display: block;
    background: var(--ink);
    color: #fff;
    text-align: center;
    font-size: 13px;
    font-weight: 600;
    padding: 10px;
  }
  .back-link:hover { background: #2A2E36; }

  .demo-flag {
    background: var(--gold-soft);
    color: #6B4E0A;
    font-size: 12.5px;
    text-align: center;
    padding: 8px;
    font-weight: 600;
  }

  .topbar {
    display: flex; align-items: center; gap: 10px;
    padding: 20px 32px;
    border-bottom: 1px solid var(--border);
    background: var(--panel);
  }
  .brand { font-family: var(--display); font-weight: 700; font-size: 21px; font-style: italic; }
  .brand .mark { color: var(--wine); font-style: normal; }

  .app {
    display: grid;
    grid-template-columns: 360px 1fr;
    gap: 26px;
    max-width: 1180px;
    margin: 0 auto;
    padding: 32px;
  }
  @media (max-width: 900px) { .app { grid-template-columns: 1fr; } }

  /* FORM PANEL */
  .form-panel {
    background: var(--panel);
    border: 1px solid var(--border);
    border-radius: 16px;
    padding: 26px;
    height: fit-content;
  }
  .form-panel h2 { font-family: var(--display); font-size: 19px; font-weight: 600; margin-bottom: 4px; }
  .form-panel .sub { color: var(--muted); font-size: 13px; margin-bottom: 22px; }

  .field { margin-bottom: 16px; }
  .field label { display: block; font-size: 12.5px; font-weight: 600; color: var(--muted); margin-bottom: 6px; }
  .field input, .field select {
    width: 100%;
    padding: 10px 12px;
    border-radius: 9px;
    border: 1px solid var(--border);
    background: var(--panel-2);
    font-family: var(--body);
    font-size: 13.5px;
    color: var(--ink);
  }
  .field input:focus, .field select:focus { outline: 2px solid var(--wine); outline-offset: 1px; }
  .row3 { display: grid; grid-template-columns: repeat(3, 1fr); gap: 10px; }

  .chip-grid { display: flex; flex-wrap: wrap; gap: 8px; }
  .chip {
    font-size: 12.5px;
    padding: 7px 13px;
    border-radius: 999px;
    border: 1px solid var(--border);
    background: var(--panel-2);
    color: var(--muted);
    cursor: pointer;
    transition: all 0.2s var(--ease);
    user-select: none;
  }
  .chip.on { background: var(--wine); color: #fff; border-color: var(--wine); }

  .gen-btn {
    width: 100%;
    margin-top: 22px;
    background: var(--wine);
    color: #fff;
    border: none;
    font-family: var(--body);
    font-weight: 700;
    font-size: 14px;
    padding: 13px;
    border-radius: 999px;
    cursor: pointer;
    display: flex; align-items: center; justify-content: center; gap: 8px;
    transition: transform 0.2s var(--ease), box-shadow 0.2s var(--ease), background 0.2s var(--ease);
  }
  .gen-btn:hover { transform: translateY(-2px); box-shadow: 0 10px 22px rgba(122,46,58,0.3); background: #601F29; }
  .gen-btn:disabled { opacity: 0.65; cursor: default; transform: none; box-shadow: none; }
  .spark { display: inline-block; }
  .gen-btn.loading .spark { animation: spin 0.9s linear infinite; }
  @keyframes spin { to { transform: rotate(360deg); } }

  /* LISTING CARD */
  .listing-card {
    background: var(--panel);
    border: 1px solid var(--border);
    border-radius: 18px;
    overflow: hidden;
  }
  .hero-wrap { position: relative; height: 320px; background: var(--panel-2); }
  .hero-wrap img { width: 100%; height: 100%; object-fit: cover; opacity: 0; transition: opacity 0.5s var(--ease); }
  .hero-wrap img.loaded { opacity: 1; }
  .hero-skeleton {
    position: absolute; inset: 0;
    background: linear-gradient(90deg, var(--panel-2) 25%, #E1E3E9 50%, var(--panel-2) 75%);
    background-size: 200% 100%;
    animation: shimmer 1.3s infinite;
    display: none;
  }
  .hero-skeleton.show { display: block; }
  @keyframes shimmer { 0% { background-position: 200% 0; } 100% { background-position: -200% 0; } }
  .price-badge {
    position: absolute; top: 16px; left: 16px;
    background: var(--ink);
    color: #fff;
    font-family: var(--display);
    font-weight: 700;
    font-size: 20px;
    padding: 8px 16px;
    border-radius: 10px;
  }
  .regen-btn {
    position: absolute; bottom: 14px; right: 14px;
    background: rgba(20,23,28,0.75);
    color: #fff;
    border: none;
    font-size: 12px;
    font-weight: 600;
    padding: 7px 13px;
    border-radius: 999px;
    cursor: pointer;
    backdrop-filter: blur(4px);
  }
  .regen-btn:hover { background: rgba(20,23,28,0.92); }

  .listing-body { padding: 26px; }
  .listing-address { font-family: var(--display); font-size: 24px; font-weight: 600; margin-bottom: 4px; }
  .listing-sub { color: var(--muted); font-size: 13.5px; margin-bottom: 18px; }

  .spec-row { display: flex; gap: 22px; padding: 16px 0; border-top: 1px solid var(--border); border-bottom: 1px solid var(--border); margin-bottom: 22px; }
  .spec { text-align: center; }
  .spec .num { font-family: var(--display); font-size: 19px; font-weight: 700; }
  .spec .lbl { font-size: 11.5px; color: var(--muted); text-transform: uppercase; letter-spacing: 0.05em; }

  .feature-tags { display: flex; flex-wrap: wrap; gap: 8px; margin-bottom: 20px; }
  .feature-tag { font-size: 12px; font-weight: 600; color: var(--gold); background: var(--gold-soft); padding: 5px 11px; border-radius: 999px; }

  .desc-block { min-height: 130px; }
  .skeleton-line { height: 14px; border-radius: 5px; background: linear-gradient(90deg, var(--panel-2) 25%, #E1E3E9 50%, var(--panel-2) 75%); background-size: 200% 100%; animation: shimmer 1.3s infinite; margin-bottom: 11px; }
  .skeleton-line.short { width: 55%; }
  .desc-text p { font-size: 14.5px; color: #3A3E46; margin-bottom: 13px; opacity: 0; transform: translateY(6px); animation: reveal 0.5s var(--ease) forwards; }
  @keyframes reveal { to { opacity: 1; transform: translateY(0); } }
  .placeholder-text { color: var(--muted); font-size: 14px; }

  .card-actions { display: flex; gap: 10px; margin-top: 22px; }
  .copy-btn {
    background: var(--panel-2);
    border: 1px solid var(--border);
    color: var(--ink);
    font-family: var(--body);
    font-weight: 600;
    font-size: 13px;
    padding: 10px 18px;
    border-radius: 999px;
    cursor: pointer;
    transition: border-color 0.2s var(--ease);
  }
  .copy-btn:hover { border-color: var(--wine); }
  .copy-toast { font-size: 13px; color: var(--wine); align-self: center; opacity: 0; transition: opacity 0.3s var(--ease); }
  .copy-toast.show { opacity: 1; }

  footer { text-align: center; padding: 10px 0 50px; color: #A8ACB6; font-size: 12px; }

  @media (prefers-reduced-motion: reduce) {
    * { animation: none !important; transition: none !important; }
    .desc-text p { opacity: 1; transform: none; }
  }
</style>
</head>
<body>

<a href="../index.html" class="back-link">← Back to WorksByFontaine portfolio</a>
<div class="demo-flag">⚠ Prototype demo — listing copy and photos are generated client-side from templates, not a live AI service</div>

<div class="topbar">
  <div class="brand"><span class="mark">◆</span> Listed</div>
</div>

<div class="app">

  <div class="form-panel">
    <h2>Property details</h2>
    <p class="sub">Fill in the basics — Listed writes the rest.</p>

    <div class="field">
      <label>Address</label>
      <input id="addressInput" type="text" value="214 Maple Ridge Court, Asheville, NC">
    </div>

    <div class="field">
      <label>List price</label>
      <input id="priceInput" type="text" value="$649,000">
    </div>

    <div class="field">
      <label>Beds · Baths · Sqft</label>
      <div class="row3">
        <input id="bedsInput" type="number" value="4">
        <input id="bathsInput" type="number" value="3">
        <input id="sqftInput" type="number" value="2850">
      </div>
    </div>

    <div class="field">
      <label>Features</label>
      <div class="chip-grid" id="featureChips">
        <div class="chip on" data-f="Updated kitchen">Updated kitchen</div>
        <div class="chip on" data-f="Mountain views">Mountain views</div>
        <div class="chip" data-f="Pool">Pool</div>
        <div class="chip" data-f="Home office">Home office</div>
        <div class="chip on" data-f="Hardwood floors">Hardwood floors</div>
        <div class="chip" data-f="2-car garage">2-car garage</div>
        <div class="chip" data-f="Fireplace">Fireplace</div>
        <div class="chip" data-f="Fenced yard">Fenced yard</div>
      </div>
    </div>

    <div class="field">
      <label>Tone</label>
      <select id="toneSelect">
        <option value="luxury">Luxury</option>
        <option value="family">Family-friendly</option>
        <option value="investor">Investor-focused</option>
      </select>
    </div>

    <button class="gen-btn" id="generateBtn"><span class="spark">✦</span> Generate listing</button>
  </div>

  <div class="listing-card">
    <div class="hero-wrap">
      <div class="hero-skeleton" id="heroSkeleton"></div>
      <img id="heroImg" src="https://picsum.photos/seed/house204/1000/600" class="loaded" alt="Property photo">
      <div class="price-badge" id="priceBadge">$649,000</div>
      <button class="regen-btn" id="regenImgBtn">Regenerate photo</button>
    </div>
    <div class="listing-body">
      <div class="listing-address" id="listingAddress">214 Maple Ridge Court</div>
      <div class="listing-sub" id="listingCity">Asheville, NC</div>

      <div class="spec-row">
        <div class="spec"><div class="num" id="specBeds">4</div><div class="lbl">Beds</div></div>
        <div class="spec"><div class="num" id="specBaths">3</div><div class="lbl">Baths</div></div>
        <div class="spec"><div class="num" id="specSqft">2,850</div><div class="lbl">Sqft</div></div>
      </div>

      <div class="feature-tags" id="featureTags"></div>

      <div class="desc-block">
        <div class="desc-text" id="descText">
          <p class="placeholder-text">No listing description yet — set the details on the left and hit Generate listing.</p>
        </div>
      </div>

      <div class="card-actions">
        <button class="copy-btn" id="copyBtn">Copy listing text</button>
        <div class="copy-toast" id="copyToast">✓ Copied</div>
      </div>
    </div>
  </div>

</div>

<footer>Listed — a property listing generator prototype by WorksByFontaine</footer>

<script>
  const openers = {
    luxury: [
      "Step into refined living at {addr} — where every detail has been considered.",
      "An exceptional offering at {addr}, built for those who expect more from a home."
    ],
    family: [
      "Welcome home to {addr} — a warm, spacious property built for everyday life.",
      "{addr} is the kind of home that grows with your family, year after year."
    ],
    investor: [
      "{addr} presents a compelling opportunity in a steadily appreciating market.",
      "A well-positioned asset, {addr} offers strong fundamentals for the discerning buyer."
    ]
  };

  const featurePhrases = {
    "Updated kitchen": "the fully updated kitchen anchors the main living space with clean lines and quality finishes",
    "Mountain views": "sweeping mountain views stretch out from nearly every south-facing window",
    "Pool": "a private pool creates a resort-like feel just steps from the back door",
    "Home office": "a dedicated home office makes remote work easy without sacrificing living space",
    "Hardwood floors": "wide-plank hardwood floors run throughout the main living areas",
    "2-car garage": "a two-car garage adds everyday convenience and extra storage",
    "Fireplace": "a wood-burning fireplace anchors the living room for cooler evenings",
    "Fenced yard": "the fully fenced yard offers privacy and room to spread out outdoors"
  };

  const closers = {
    luxury: ["A rare combination of comfort and craftsmanship — this one won't stay available long.", "Schedule a private showing to experience everything this property offers."],
    family: ["Close to schools, parks, and everyday conveniences — this one checks every box.", "Come see for yourself why this home feels right the moment you walk in."],
    investor: ["With strong comparables in the area, this property is well worth a closer look.", "A solid addition to any portfolio, in a location with consistent demand."]
  };

  let selectedFeatures = ['Updated kitchen', 'Mountain views', 'Hardwood floors'];

  document.querySelectorAll('.chip').forEach(chip => {
    chip.addEventListener('click', () => {
      chip.classList.toggle('on');
      const f = chip.dataset.f;
      if (chip.classList.contains('on')) {
        if (!selectedFeatures.includes(f)) selectedFeatures.push(f);
      } else {
        selectedFeatures = selectedFeatures.filter(x => x !== f);
      }
    });
  });

  function pick(arr) { return arr[Math.floor(Math.random() * arr.length)]; }

  function updateSpecs() {
    const addr = document.getElementById('addressInput').value;
    const [street, ...rest] = addr.split(',');
    document.getElementById('listingAddress').textContent = street.trim();
    document.getElementById('listingCity').textContent = rest.join(',').trim();
    document.getElementById('priceBadge').textContent = document.getElementById('priceInput').value;
    document.getElementById('specBeds').textContent = document.getElementById('bedsInput').value;
    document.getElementById('specBaths').textContent = document.getElementById('bathsInput').value;
    document.getElementById('specSqft').textContent = Number(document.getElementById('sqftInput').value).toLocaleString();

    const tagsEl = document.getElementById('featureTags');
    tagsEl.innerHTML = selectedFeatures.map(f => `<span class="feature-tag">${f}</span>`).join('');
  }

  document.getElementById('generateBtn').addEventListener('click', () => {
    updateSpecs();
    const btn = document.getElementById('generateBtn');
    btn.disabled = true;
    btn.classList.add('loading');

    const descText = document.getElementById('descText');
    descText.innerHTML = `<div class="skeleton-line"></div><div class="skeleton-line"></div><div class="skeleton-line short"></div><div class="skeleton-line"></div>`;

    setTimeout(() => {
      const tone = document.getElementById('toneSelect').value;
      const addr = document.getElementById('addressInput').value.split(',')[0];
      const beds = document.getElementById('bedsInput').value;
      const baths = document.getElementById('bathsInput').value;
      const sqft = Number(document.getElementById('sqftInput').value).toLocaleString();

      const opener = pick(openers[tone]).replace('{addr}', addr);
      const featureSentence = selectedFeatures.length
        ? "Inside, " + selectedFeatures.slice(0, 3).map(f => featurePhrases[f]).join(', while ') + '.'
        : "The layout is thoughtfully designed for both everyday living and entertaining.";
      const specSentence = `This ${beds}-bedroom, ${baths}-bath home offers ${sqft} square feet of well-planned living space.`;
      const closer = pick(closers[tone]);

      const paragraphs = [opener, specSentence, featureSentence, closer];
      descText.innerHTML = paragraphs.map((p, i) => `<p style="animation-delay:${i*0.12}s">${p}</p>`).join('');

      btn.disabled = false;
      btn.classList.remove('loading');
    }, 1000);
  });

  document.getElementById('regenImgBtn').addEventListener('click', () => {
    const heroImg = document.getElementById('heroImg');
    const skeleton = document.getElementById('heroSkeleton');
    heroImg.classList.remove('loaded');
    skeleton.classList.add('show');
    const seed = Math.floor(Math.random() * 100000);
    const newSrc = `https://picsum.photos/seed/house${seed}/1000/600`;
    const img = new Image();
    img.onload = () => {
      heroImg.src = newSrc;
      heroImg.classList.add('loaded');
      skeleton.classList.remove('show');
    };
    img.src = newSrc;
  });

  document.getElementById('copyBtn').addEventListener('click', () => {
    const text = document.getElementById('descText').innerText;
    navigator.clipboard.writeText(text).catch(() => {});
    const toast = document.getElementById('copyToast');
    toast.classList.add('show');
    setTimeout(() => toast.classList.remove('show'), 1600);
  });

  // init
  updateSpecs();
</script>

</body>
</html>
